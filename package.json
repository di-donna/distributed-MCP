{
  "name": "distributed-mcp",
  "version": "0.2.0",
  "description": "Shared knowledge base, log streams and task queue for teams of Claude agents, served as a remote MCP server (Claude custom connector).",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "hive-admin": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "admin": "tsx src/cli.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=20.11"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "express-rate-limit": "^8.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
