# With docker compose, DOMAIN is the only required value; everything else has a sensible default.

# ---- docker compose (Caddy + automatic HTTPS) ----
# DNS name that points at this machine. Claude connects from Anthropic's cloud, so it must be reachable from the internet.
DOMAIN=hive.example.com
# Image to run (default ghcr.io/di-donna/hive-mcp:latest). Pin a version such as ghcr.io/di-donna/hive-mcp:0.1.0 for stable upgrades.
# HIVE_IMAGE=ghcr.io/di-donna/hive-mcp:latest

# ---- server ----
# Public base URL (the OAuth issuer). docker-compose derives it from DOMAIN; set it yourself for other hosts, e.g. Fly/Railway/Render.
# PUBLIC_URL=https://hive.example.com
HIVE_TEAM_NAME=Hive
HIVE_ADMIN_NAME=admin
# Optional: fix the admin API key instead of having one generated and printed on first boot.
# Must start with hv_key_ and be at least 32 characters long, or the server refuses to start.
# HIVE_ADMIN_KEY=hv_key_change-me-to-something-long-and-random
# Hosts allowed to act as OAuth clients via Client ID Metadata Documents (Claude's "published identity"). "*" allows any https host.
CIMD_ALLOWED_HOSTS=claude.ai,claude.com,anthropic.com
# Set to 1 when behind a reverse proxy / load balancer so rate limiting sees real client IPs.
TRUST_PROXY=1

# ---- rarely changed ----
# PORT=8787
# HOST=0.0.0.0
# DB_PATH=/data/hive.db
# ACCESS_TOKEN_TTL_SEC=86400
# REFRESH_TOKEN_TTL_SEC=7776000
# MAX_DOC_BYTES=524288
# MCP_JSON_RESPONSES=1
